        <mxCell id="account-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fce5cd;strokeColor=#c27ba0;fontSize=13;" value="Reference Data&#xa;Data/Spotify Account Data/*.json&#xa;Present in repo, not used by current pipeline" vertex="1">
