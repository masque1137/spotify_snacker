        <mxCell id="csv-out" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ead3;strokeColor=#6aa84f;fontSize=14;" value="Intermediate Outputs&#xa;Results/combined_streaming_data.csv&#xa;Results/filtered_streaming_data.csv" vertex="1">
          <mxGeometry height="90" width="320" x="1630" y="175" as="geometry" />
        </mxCell>
        <mxCell id="html-out" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ead3;strokeColor=#6aa84f;fontSize=14;" value="Visualization Outputs&#xa;Results/*.html&#xa;histogram, hourly, monthly,&#xa;top artists, top tracks, skip charts, pie charts" vertex="1">
          <mxGeometry height="110" width="320" x="1630" y="345" as="geometry" />
