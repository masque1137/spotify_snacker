        <mxCell id="viz" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" value="visualize.py&#xa;Plotly chart builders" vertex="1">
          <mxGeometry height="80" width="270" x="1090" y="390" as="geometry" />
