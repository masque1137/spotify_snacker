        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="input-data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;" target="main" value="reads files">
          <mxGeometry relative="1" as="geometry" />
