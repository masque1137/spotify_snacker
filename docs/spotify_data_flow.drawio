        <mxCell id="input-data" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" value="Input Data&#xa;Data/Spotify Extended Streaming History/*.json" vertex="1">
          <mxGeometry height="80" width="250" x="40" y="120" as="geometry" />
