        <mxCell id="utils" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" value="utility_methods.py&#xa;ensure_results_directory()&#xa;filter_by_date_range()&#xa;filter_by_bools()&#xa;save_data()" vertex="1">
          <mxGeometry height="120" width="270" x="1090" y="240" as="geometry" />
